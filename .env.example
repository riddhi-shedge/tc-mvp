# ==========================================================================
# tc-mvp environment variables — TEMPLATE
#
# Copy this file to `.env` and fill real values from your password manager:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed.
# These are placeholders ONLY — no real keys in this file, it IS committed.
#
# SAFETY: Until the Anthropic Zero Data Retention agreement is CONFIRMED
# active, only synthetic data may touch any of these services.
# ==========================================================================

# ---- Supabase (system of record) ------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key          # frontend-safe ONLY because RLS is on
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # BACKEND ONLY — bypasses row-level security
# Project Settings -> API -> JWT Settings (legacy JWT secret). Backend only —
# used to verify the TC's session token (HS256) on every API route.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# MFA (aal2) is required on every route. Only ever set to false in a local
# experiment; never in a deployed environment.
REQUIRE_MFA=true

# ---- Anthropic (extraction + drafting) ------------------------------------
# console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# ---- Postmark (inbound parse = MVP trigger; outbound send) -----------------
# Server -> API Tokens (use the SERVER token, not the Account token)
POSTMARK_SERVER_TOKEN=your-postmark-server-token
# The dedicated deal address emails are forwarded/BCC'd to (not secret):
POSTMARK_INBOUND_ADDRESS=your-hash@inbound.postmarkapp.com
# Verified sender signature used as the outbound "From":
POSTMARK_FROM_EMAIL=your-verified-email@example.com
# Shared secret appended by Postmark to the inbound webhook URL (?token=...):
POSTMARK_WEBHOOK_TOKEN=generate-a-long-random-token

# ---- Backend wiring ---------------------------------------------------------
# Where the ingestion agent reaches the master API (parts talk only via API):
MASTER_API_BASE=http://localhost:8000
# CORS origin of the frontend dev server:
FRONTEND_ORIGIN=http://localhost:5173
