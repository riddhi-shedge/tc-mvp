# ==========================================================================
# tc-mvp environment variables — TEMPLATE
#
# Copy this file to `.env` and fill real values from your password manager:
#     cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed.
# These are placeholders ONLY — no real keys in this file, it IS committed.
#
# SAFETY: Until the Anthropic Zero Data Retention agreement is CONFIRMED
# active, only synthetic data may touch any of these services.
# ==========================================================================

# ---- Supabase (system of record) ------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key          # frontend-safe ONLY because RLS is on
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # BACKEND ONLY — bypasses row-level security
# Project Settings -> API -> JWT Settings (legacy JWT secret). Backend only —
# used to verify the TC's session token (HS256) on every API route.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# MFA (aal2) is required on every route. Only ever set to false in a local
# experiment; never in a deployed environment.
REQUIRE_MFA=true

# ---- Anthropic (extraction + drafting) ------------------------------------
# console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
# *** THE ZDR GATE (Rule 5, §3 hard gate) ***
# NO REAL CLIENT DOCUMENT may enter this system until Anthropic
# zero-data-retention is CONFIRMED active for your org. Until then the system
# runs synthetic-only. Extraction HARD-STOPS if SYNTHETIC_ONLY=false while
# ZDR_CONFIRMED is not true.
ZDR_CONFIRMED=false
SYNTHETIC_ONLY=true
# Model used for §5 field extraction:
EXTRACTION_MODEL=claude-sonnet-5
# Minimum pages expected of a purchase agreement before extraction:
PA_MIN_PAGES=2

# ---- Postmark (inbound parse = MVP trigger; outbound send) -----------------
# Server -> API Tokens (use the SERVER token, not the Account token)
POSTMARK_SERVER_TOKEN=your-postmark-server-token
# The dedicated deal address emails are forwarded/BCC'd to (not secret):
POSTMARK_INBOUND_ADDRESS=your-hash@inbound.postmarkapp.com
# Verified sender signature used as the outbound "From":
POSTMARK_FROM_EMAIL=your-verified-email@example.com
# Shared secret appended by Postmark to the inbound webhook URL (?token=...):
POSTMARK_WEBHOOK_TOKEN=generate-a-long-random-token

# ---- Outbound send (Phase 6 — GUARDED, off by default) --------------------
# *** Rule 3: a human approves every send; there is no auto-send path. ***
# Real email stays OFF until BOTH are set. Postmark is pending production
# approval and only delivers to verified addresses regardless (§16).
SEND_ENABLED=false
# Comma-separated verified recipient addresses the guard will allow:
SEND_ALLOWLIST=
# Model for lender drafting (gated by the same ZDR/synthetic gate as extraction):
DRAFTING_MODEL=claude-sonnet-5
# Days after a send before the "no reply" follow-up reminder surfaces:
FOLLOWUP_DAYS=3

# ---- Backend wiring ---------------------------------------------------------
# Where the ingestion agent reaches the master API (parts talk only via API):
MASTER_API_BASE=http://localhost:8000
# CORS origin of the frontend dev server:
FRONTEND_ORIGIN=http://localhost:5173
# Shared secret for the compliance runner -> master compliance-result endpoint
# (a machine can't do MFA; constant-time compared, fails closed):
COMPLIANCE_SERVICE_TOKEN=generate-a-long-random-token

# ---- Compliance / CA rules (Phase 5) --------------------------------------
# *** THE CA-RULES GATE (§11, §18) ***
# The compliance service will NOT compute real deadlines until a human verifies
# the California rules against the literal current C.A.R. RPA/NBP forms
# (docs/ca-rules-verification.md), fills VERIFIED_RULESET in
# app/compliance/ca_rules.py, AND sets this flag true. Until then the service
# hard-stops (RulesNotVerified). Wrong date math silently corrupts every task.
CA_RULES_VERIFIED=false
